{
  "name": "dobon-pirates",
  "private": true,
  "version": "0.0.0",
  "description": "ドボン(トランプゲーム)をスマホで遊べるWebゲームにするプロジェクト",
  "engines": { "node": ">=20" },
  "workspaces": ["apps/*", "packages/*"],
  "scripts": {
    "dev": "npm run dev -w @dobon/web",
    "build": "npm run build -w @dobon/web",
    "test": "vitest run",
    "typecheck": "tsc --noEmit -p apps/web"
  },
  "devDependencies": {
    "typescript": "~5.6.3",
    "vitest": "^2.1.8"
  }
}
